# tests/gates/crumb-verify.gate
# Mirrors hosted: crumb verify . (ADR 0033 D11; always-run). Inputs cannot list every nested .crumb (literal paths only), so never cached.
gate: CRUMB-VERIFY
manifest_version: 2
owner: spark-rsi
requires:
  - portable
inputs:
  - .crumb
run:
  exec: tests/gates/run.sh
  args: ["crumb-verify"]
expects:
  exit: 0
  verdict: PASS
timeout: 2m
exactness: EXACT
cache_scope: portable
cache: never
