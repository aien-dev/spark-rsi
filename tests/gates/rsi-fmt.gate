# tests/gates/rsi-fmt.gate
# Mirrors hosted: ci.yml 'Verify Code Formatting': cargo fmt --all -- --check (host: needs the ../aien-protocols sibling)
gate: RSI-FMT
manifest_version: 2
owner: spark-rsi
requires:
  - host
inputs:
  - Cargo.toml
  - Cargo.lock
  - src/
  - tests/
  - examples/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["fmt"]
expects:
  exit: 0
  verdict: PASS
timeout: 5m
exactness: EXACT
cache_scope: portable
